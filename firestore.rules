rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validation Helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'paypalHandle', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('paypalHandle' in data) || (data.paypalHandle is string && data.paypalHandle.size() <= 64));
    }

    function isValidProject(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'description', 'category', 'status', 'tags', 'repoFullName', 'driveFolderId', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == userId
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && data.status in ['active', 'archived', 'concept']
        && (!('description' in data) || (data.description is string && data.description.size() <= 2048))
        && (!('category' in data) || (data.category is string && data.category.size() <= 64))
        && (!('repoFullName' in data) || (data.repoFullName is string && data.repoFullName.size() <= 256))
        && (!('driveFolderId' in data) || (data.driveFolderId is string && data.driveFolderId.size() <= 128))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20));
    }

    function isValidTask(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'status', 'priority', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'description', 'status', 'priority', 'source', 'sourceUrl', 'sourceTitle', 'tags', 'dueDate', 'createdAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == userId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 256
        && data.status in ['todo', 'in_progress', 'done']
        && data.priority in ['low', 'medium', 'high']
        && (!('source' in data) || data.source in ['manual', 'github', 'drive', 'ai', 'bridge'])
        && (!('description' in data) || (data.description is string && data.description.size() <= 4096))
        && (!('sourceUrl' in data) || (data.sourceUrl is string && data.sourceUrl.size() <= 1024))
        && (!('sourceTitle' in data) || (data.sourceTitle is string && data.sourceTitle.size() <= 256))
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 64))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20));
    }

    function isValidNote(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'content', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'content', 'tags', 'linkedFileId', 'linkedRepo', 'color', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == userId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 256
        && data.content is string && data.content.size() <= 16384
        && (!('linkedFileId' in data) || (data.linkedFileId is string && data.linkedFileId.size() <= 128))
        && (!('linkedRepo' in data) || (data.linkedRepo is string && data.linkedRepo.size() <= 256))
        && (!('color' in data) || (data.color is string && data.color.size() <= 32))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20));
    }

    function isValidBridge(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'sourceModule', 'targetModule', 'status'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'sourceModule', 'targetModule', 'status', 'autoSync', 'syncIntervalMinutes', 'lastSyncAt', 'packetsCount'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == userId
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && data.sourceModule is string && data.sourceModule.size() <= 64
        && data.targetModule is string && data.targetModule.size() <= 64
        && data.status in ['active', 'paused', 'syncing', 'error']
        && (!('autoSync' in data) || data.autoSync is bool)
        && (!('syncIntervalMinutes' in data) || data.syncIntervalMinutes is number)
        && (!('packetsCount' in data) || data.packetsCount is number);
    }

    function isValidSyncLog(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'source', 'status', 'message', 'timestamp'])
        && data.keys().hasOnly(['id', 'userId', 'source', 'status', 'itemCount', 'message', 'durationMs', 'timestamp'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == userId
        && data.source in ['github', 'drive', 'all', 'bridge']
        && data.status in ['success', 'error', 'warning']
        && data.message is string && data.message.size() <= 1024
        && (!('itemCount' in data) || data.itemCount is number)
        && (!('durationMs' in data) || data.durationMs is number);
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Disallow querying across all users
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Projects Subcollection
      match /projects/{projectId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(projectId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(projectId) && isValidProject(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(projectId) && isValidProject(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(projectId);
      }

      // Tasks Subcollection
      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(taskId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(taskId) && isValidTask(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(taskId) && isValidTask(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(taskId);
      }

      // Notes Subcollection
      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(noteId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(noteId) && isValidNote(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(noteId) && isValidNote(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(noteId);
      }

      // Bridges Subcollection
      match /bridges/{bridgeId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(bridgeId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(bridgeId) && isValidBridge(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(bridgeId) && isValidBridge(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(bridgeId);
      }

      // Sync Logs Subcollection
      match /syncLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(logId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(logId) && isValidSyncLog(incoming(), userId);
        allow update: if false; // Logs are immutable once written
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(logId);
      }
    }
  }
}
