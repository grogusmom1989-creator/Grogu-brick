{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with authentication and workspace metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "githubUsername": { "type": "string", "maxLength": 100 },
        "paypalHandle": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "uid", "email", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "A workspace portfolio project synced across GitHub, Drive, or custom.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200, "minLength": 1 },
        "description": { "type": "string", "maxLength": 2048 },
        "source": { "type": "string", "enum": ["github", "drive", "custom", "internal", "upload"] },
        "status": { "type": "string", "enum": ["active", "in_progress", "deployed", "archived", "concept"] },
        "tags": { "type": "array", "description": "Up to 25 project tags" },
        "techStack": { "type": "array", "description": "Up to 25 tech stack items" },
        "url": { "type": "string", "maxLength": 1024 },
        "homepageUrl": { "type": "string", "maxLength": 1024 },
        "repoFullName": { "type": "string", "maxLength": 256 },
        "driveFolderId": { "type": "string", "maxLength": 200 },
        "version": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 5000 },
        "isPinned": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name", "status", "createdAt", "updatedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "Actionable to-do item linked to GitHub issues, Drive docs, or manual input.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300, "minLength": 1 },
        "description": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "enum": ["todo", "in_progress", "done"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "source": { "type": "string", "enum": ["manual", "github", "drive", "ai", "bridge"] },
        "sourceUrl": { "type": "string", "maxLength": 1024 },
        "sourceTitle": { "type": "string", "maxLength": 300 },
        "tags": { "type": "array" },
        "dueDate": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "status", "priority", "createdAt"]
    },
    "Note": {
      "title": "Note",
      "description": "Quick notes and ideas with tags and cross-service linkages.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300, "minLength": 1 },
        "content": { "type": "string", "maxLength": 50000 },
        "tags": { "type": "array" },
        "pinned": { "type": "boolean" },
        "linkedDriveFileId": { "type": "string", "maxLength": 200 },
        "linkedGithubRepo": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "content", "updatedAt"]
    },
    "Bridge": {
      "title": "Bridge",
      "description": "Cross-project connector configuration linking hubs and applications.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200, "minLength": 1 },
        "sourceModule": { "type": "string", "maxLength": 100 },
        "targetModule": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1500 },
        "status": { "type": "string", "enum": ["active", "paused", "syncing", "idle", "error"] },
        "syncMode": { "type": "string", "enum": ["realtime", "event_driven", "poll", "manual"] },
        "latencyMs": { "type": "number" },
        "packetsCount": { "type": "number" },
        "lastEventAt": { "type": "string", "maxLength": 64 },
        "enabled": { "type": "boolean" },
        "category": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name", "sourceModule", "targetModule", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Root user profile document."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "User's managed portfolio and repository projects."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Actionable task items belonging to the authenticated user."
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "Note",
      "description": "Quick notes and documentation created by the user."
    },
    "/users/{userId}/bridges/{bridgeId}": {
      "schema": "Bridge",
      "description": "Configured bridge connectors linking apps."
    }
  }
}
